{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/endpoint-evaluation-attempt.schema.json",
  "title": "Immutable endpoint evaluation attempt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "parent_id",
    "endpoint_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^endpoint_attempt_[a-f0-9]{32}$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^endpoint_attempt_[a-f0-9]{32}$"
    },
    "endpoint_binding": {
      "$ref": "external-endpoint-binding.schema.json"
    }
  }
}
